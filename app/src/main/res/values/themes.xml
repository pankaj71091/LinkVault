<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      This is only the platform-level window theme (used before Compose draws
      anything, e.g. for the window background color). It intentionally has no
      dependency on the Material Components library — actual UI theming
      (colors, typography, dark mode) is handled entirely by Compose Material3
      in ui/theme/Theme.kt.
    -->
    <style name="Theme.LinkVault" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      Used by LinkCaptureActivity. Changed from a native Dialog theme to a
      translucent full-screen theme to allow Compose's ModalBottomSheet to
      control the entrance animation and background dimming.
    -->
    <style name="Theme.LinkVault.Dialog" parent="Theme.LinkVault">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
